{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/qr",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/reels-demo",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/reels-demo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://videonotes.vkrbt.me"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xml; charset=UTF-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/vstrecha",
      "destination": "/",
      "permanent": true
    }
  ]
}
